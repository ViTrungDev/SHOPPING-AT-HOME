<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Roboto', sans-serif;
        }
        .sidebar {
            width: 250px;
            height: 100vh;
            position: fixed;
            background-color: #fff;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }
        .sidebar .nav-link {
            color: #6c757d;
        }
        .sidebar .nav-link.active {
            color: #e83e8c;
        }
        .content {
            margin-left: 250px;
            padding: 20px;
        }
        .card-icon {
            font-size: 2rem;
            color: #e83e8c;
        }
        .chart-placeholder {
            background-color: #f8f9fa;
            height: 300px;
            position: relative;
        }
        .chart-placeholder .centered-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background-color: #e83e8c;
            color: #fff;
            padding: 10px 20px;
            border-radius: 5px;
        }
        .pie-chart-placeholder {
            background-color: #f8f9fa;
            height: 200px;
            position: relative;
        }
        .pie-chart-placeholder .centered-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: #e83e8c;
            font-size: 1.5rem;
            font-weight: bold;
        }
    </style>
</head>
<body class="bg-light">
    <div class="sidebar d-flex flex-column p-3">
        <img src="https://storage.googleapis.com/a1aa/image/wohSwbzVn442fhDfZPlFfkVqrbdi-VsnDfsKoHk5JLA.jpg" alt="Market Logo" class="mb-4" width="150">
        <h2 class="h5">Quản lý</h2>
        <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item">
                <a href="#" class="nav-link active">
                    <i class="fas fa-tachometer-alt me-2"></i>
                    Bảng điều khiển
                </a>
            </li>
            <li>
                <a href="#" class="nav-link">
                    <i class="fas fa-users me-2"></i>
                    Customers
                </a>
            </li>
            <li>
                <a href="#" class="nav-link">
                    <i class="fas fa-chart-line me-2"></i>
                    Analytics
                </a>
            </li>
            <li>
                <a href="#" class="nav-link">
                    <i class="fas fa-tachometer-alt me-2"></i>
                    Performance
                </a>
            </li>
            <li>
                <a href="#" class="nav-link">
                    <i class="fas fa-bell me-2"></i>
                    Notification
                </a>
            </li>
            <li>
                <a href="#" class="nav-link">
                    <i class="fas fa-cog me-2"></i>
                    Settings
                </a>
            </li>
            <li>
                <a href="#" class="nav-link">
                    <i class="fas fa-palette me-2"></i>
                    Theme
                </a>
            </li>
            <li>
                <a href="#" class="nav-link">
                    <i class="fas fa-shield-alt me-2"></i>
                    Security
                </a>
            </li>
        </ul>
        <div class="mt-auto d-flex align-items-center">
            <img src="https://storage.googleapis.com/a1aa/image/-ml0r3o6ZgSghseSVHyIrm75ZBhkHGs1eqDMVDCJd4A.jpg" alt="User Avatar" class="rounded-circle me-2" width="40" height="40">
            <div>
                <p class="mb-0 fw-bold">Itai Bracha</p>
                <p class="mb-0 text-muted">itaibracha21@gmail.com</p>
            </div>
        </div>
    </div>
    <div class="content">
        <header class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3">Bảng điều khiển</h1>
            <div class="d-flex align-items-center">
                <i class="fas fa-search text-muted me-3"></i>
                <i class="fas fa-bell text-muted me-3"></i>
                <i class="fas fa-ellipsis-v text-muted"></i>
            </div>
        </header>
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title text-muted">Total Balance</h5>
                            <p class="card-text h4">$3140.74</p>
                        </div>
                        <i class="fas fa-wallet card-icon"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title text-muted">Total spending</h5>
                            <p class="card-text h4">$42.040</p>
                        </div>
                        <i class="fas fa-shopping-cart card-icon"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title text-muted">Money saved</h5>
                            <p class="card-text h4">$501.074</p>
                        </div>
                        <i class="fas fa-dollar-sign card-icon"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="row mb-4">
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title text-muted">Overview</h5>
                        <div class="chart-placeholder">
                            <canvas id="myChart"></canvas>
                            <div class="centered-text">from 766 $</div>                            <div class="centered-text">from 766 $</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title text-muted">Activity</h5>
                        <div class="pie-chart-placeholder">
                            <img src="https://storage.googleapis.com/a1aa/image/80R0Ymx6T4Iws6bsN5eFRP2JH5EiJrSvbsbz6i2tUwc.jpg" alt="Pie chart showing activity distribution" class="img-fluid">
                            <div class="centered-text">$3.20</div>
                        </div>
                        <div class="d-flex justify-content-between text-muted mt-3">
                            <div>
                                <p>Online shop</p>
                                <p>Tax</p>
                                <p>Food</p>
                            </div>
                            <div class="text-end">
                                <p>$3.20</p>
                                <p>$1.321</p>
                                <p>$0.21</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title text-muted">Comparison (Month)</h5>
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <div class="bg-pink-600 rounded-circle me-2" style="width: 16px; height: 16px;"></div>
                        <p class="mb-0">This month</p>
                    </div>
                    <div class="d-flex align-items-center">
                        <div class="bg-dark rounded-circle me-2" style="width: 16px; height: 16px;"></div>
                        <p class="mb-0">Last month</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title text-muted">Transaction History</h5>
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Name</th>
                            <th scope="col">Description</th>
                            <th scope="col">Date</th>
                            <th scope="col">Status</th>
                            <th scope="col">Amount</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th scope="row"><input type="checkbox"></th>
                            <td>David Beaustia</td>
                            <td>BPJS Kesehatan</td>
                            <td>Jan 2, 2022</td>
                            <td class="text-pink-600">Done</td>
                            <td>$783.22</td>
                            <td><i class="fas fa-ellipsis-v"></i></td>
                        </tr>
                        <tr>
                            <th scope="row"><input type="checkbox"></th>
                            <td>Melina Panton</td>
                            <td>Online Payment</td>
                            <td>Jan 2, 2022</td>
                            <td class="text-pink-600">Done</td>
                            <td>$783.22</td>
                            <td><i class="fas fa-ellipsis-v"></i></td>
                        </tr>
                    </tbody>
                </table>
                <div class="text-muted">Showing data 1 to 8 of 256K entries</div>
                <nav aria-label="Page navigation example" class="mt-3">
                    <ul class="pagination justify-content-center">
                        <li class="page-item"><a class="page-link" href="#">1</a></li>
                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item"><a class="page-link" href="#">4</a></li>
                        <li class="page-item"><a class="page-link" href="#">...</a></li>
                        <li class="page-item"><a class="page-link" href="#">40</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('myChart').getContext('2d');
        const myChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                datasets: [{
                    label: 'Monthly Revenue',
                    data: [1200, 1500, 1800, 1900, 2400, 766, 1400, 1300, 1500, 1700, 2200, 2500],
                    backgroundColor: [
                        '#adb5bd', '#adb5bd', '#adb5bd', '#adb5bd', '#adb5bd',
                        '#d63384', // Màu nổi bật (for June)
                        '#adb5bd', '#adb5bd', '#adb5bd', '#adb5bd', '#adb5bd', '#adb5bd'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 500 // Đơn vị chia trên trục Y
                        }
                    }
                },
                plugins: {
                    legend: {
                        display: false // Ẩn chú thích biểu đồ
                    }
                }
            }
        });
    </script>
</body>
</html>